package battleship;

import static org.junit.jupiter.api.Assertions.*;

import java.util.ArrayList;

import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

class OceanTest {

	Ocean ocean;
	
	static int NUM_BATTLESHIPS = 1;
	static int NUM_CRUISERS = 2;
	static int NUM_DESTROYERS = 3;
	static int NUM_SUBMARINES = 4;
	static int OCEAN_SIZE = 10;
	
	@BeforeEach
	void setUp() throws Exception {
		ocean = new Ocean();
	}
	
	@Test
	void testEmptyOcean() {
		
		//tests that all locations in the ocean are "empty"
		
		Ship[][] ships = ocean.getShipArray();
		
		for (int i = 0; i < ships.length; i++) {
			for (int j = 0; j < ships[i].length; j++) {
				Ship ship = ships[i][j];
				
				assertEquals("empty", ship.getShipType());
			}
		}
		
		assertEquals(0, ships[0][0].getBowRow());
		assertEquals(0, ships[0][0].getBowColumn());
		
		assertEquals(5, ships[5][5].getBowRow());
		assertEquals(5, ships[5][5].getBowColumn());
		
		assertEquals(9, ships[9][0].getBowRow());
		assertEquals(0, ships[9][0].getBowColumn());
	}
	
	@Test
	void testPlaceAllShipsRandomly() {
		
		//tests that the correct number of each ship type is placed in the ocean
		
		ocean.placeAllShipsRandomly();

		Ship[][] ships = ocean.getShipArray();
		ArrayList<Ship> shipsFound = new ArrayList<Ship>();
		
		int numBattlehips = 0;
		int numCruisers = 0;
		int numDestroyers = 0;
		int numSubmarines = 0;
		int numEmptySeas = 0;
		
		for (int i = 0; i < ships.length; i++) {
			for (int j = 0; j < ships[i].length; j++) {
				Ship ship = ships[i][j];
				if (!shipsFound.contains(ship)) {
					shipsFound.add(ship);
				}
			}
		}
		
		for (Ship ship : shipsFound) {
			if ("battleship".equals(ship.getShipType())) {		
				numBattlehips++;
			} else if ("cruiser".equals(ship.getShipType())) {
				numCruisers++;
			} else if ("destroyer".equals(ship.getShipType())) {
				numDestroyers++;
			} else if ("submarine".equals(ship.getShipType())) {
				numSubmarines++;
			} else if ("empty".equals(ship.getShipType())) {
				numEmptySeas++;
			}
		}
		
		assertEquals(NUM_BATTLESHIPS, numBattlehips);
		assertEquals(NUM_CRUISERS, numCruisers);
		assertEquals(NUM_DESTROYERS, numDestroyers);
		assertEquals(NUM_SUBMARINES, numSubmarines);
		
		//calculate total number of available spaces and occupied spaces
		int totalSpaces = OCEAN_SIZE * OCEAN_SIZE; 
		int occupiedSpaces = (NUM_BATTLESHIPS * 4)
				+ (NUM_CRUISERS * 3)
				+ (NUM_DESTROYERS * 2)
				+ (NUM_SUBMARINES * 1);
		
		//test number of empty seas, each with length of 1
		assertEquals(totalSpaces - occupiedSpaces, numEmptySeas);
	}

	@Test
	void testIsOccupied() {

		Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
		
		Ship submarine = new Submarine();
		row = 0;
		column = 0;
		horizontal = false;
		submarine.placeShipAt(row, column, horizontal, ocean);
		
		assertTrue(ocean.isOccupied(1, 5));
		
		//TODO
		//More tests

    // test destroyer
    assertTrue(ocean.isOccupied(0, 0));  

    // place an EmptySea		
    Ship emptysea = new EmptySea ();
		row = 3;
		column = 1;
		horizontal = false;
		emptysea.placeShipAt(row, column, horizontal, ocean);
		
		assertFalse(ocean.isOccupied(3, 1));
	}

	@Test
	void testShootAt() {
	
		assertFalse(ocean.shootAt(0, 1));
		
		Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
		
		assertTrue(ocean.shootAt(1, 5));
		assertFalse(destroyer.isSunk());
		assertTrue(ocean.shootAt(0, 5));
		
		//TODO
		//More tests

    // shot an EmptySea
    Ship emptysea = new EmptySea ();
		row = 3;
		column = 1;
		horizontal = false;
		emptysea.placeShipAt(row, column, horizontal, ocean);
		
		assertFalse(ocean.shootAt(3, 1));
		assertFalse(emptysea.isSunk());

    // sank a Cruiser
		Cruiser cruiser = new Cruiser();
		row = 2;
		column = 5;
		horizontal = false;
		cruiser.placeShipAt(row, column, horizontal, ocean);

		assertTrue(ocean.shootAt(2, 5));
    assertFalse(cruiser.isSunk());		
		assertTrue(ocean.shootAt(1, 5));
    assertFalse(cruiser.isSunk());
    assertTrue(ocean.shootAt(0, 5));
		assertTrue(cruiser.isSunk());

    // shot at the same location twice, then sank the ship
    Destroyer destroyerTwo = new Destroyer();
		row = 1;
		column = 5;
    horizontal = true;
		destroyerTwo.placeShipAt(row, column, horizontal, ocean);

    assertTrue(ocean.shootAt(1,5)); // first shot
    assertFalse(destroyerTwo.isSunk());	

    assertTrue(ocean.shootAt(1,5)); // return true if shooting at same location
    assertFalse(destroyerTwo.isSunk());	

    assertTrue(ocean.shootAt(1,4)); // third shot to sink the ship
    assertTrue(destroyerTwo.isSunk());	

    assertFalse(ocean.shootAt(1,4)); // return false if shooting at same location when the ship is sunk
    assertTrue(destroyerTwo.isSunk());	

	}

	@Test
	void testGetShotsFired() {
		
		//should be all false - no ships added yet
		assertFalse(ocean.shootAt(0, 1));
		assertFalse(ocean.shootAt(1, 0));
		assertFalse(ocean.shootAt(3, 3));
		assertFalse(ocean.shootAt(9, 9));
		assertEquals(4, ocean.getShotsFired());
		
		Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
		
		Ship submarine = new Submarine();
		row = 0;
		column = 0;
		horizontal = false;
		submarine.placeShipAt(row, column, horizontal, ocean);
		
		assertTrue(ocean.shootAt(1, 5));
		assertFalse(destroyer.isSunk());
		assertTrue(ocean.shootAt(0, 5));
		assertTrue(destroyer.isSunk());
		assertEquals(6, ocean.getShotsFired());
		
		//TODO
		//More tests

    //shoot at same location twice
		assertFalse(ocean.shootAt(5, 6));
		assertFalse(ocean.shootAt(5, 6));
		assertEquals(8, ocean.getShotsFired());

    //shoot a sunk ship
		assertFalse(ocean.shootAt(1, 5));
		assertTrue(destroyer.isSunk());
		assertEquals(9, ocean.getShotsFired());
	}

	@Test
	void testGetHitCount() {
		
		Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
		
		assertTrue(ocean.shootAt(1, 5));
		assertFalse(destroyer.isSunk());
		assertEquals(1, ocean.getHitCount());
		
		//TODO
		//More tests

    // hit same location twice
    assertTrue(ocean.shootAt(1, 5));
    assertEquals(2, ocean.getHitCount());

    // hit a sunk ship again
    assertTrue(ocean.shootAt(0, 5)); //sink the ship
    assertTrue(destroyer.isSunk());
    assertEquals(3, ocean.getHitCount());
    
    assertFalse(ocean.shootAt(0, 5)); //hit ship again
    assertTrue(destroyer.isSunk());
    assertEquals(4, ocean.getHitCount());

    // shoot an emptySea
    assertFalse(ocean.shootAt(0, 0)); //hit ship again
    assertEquals(4, ocean.getHitCount());

	}
	
	@Test
	void testGetShipsSunk() {
		
		Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
		
		assertTrue(ocean.shootAt(1, 5));
		assertFalse(destroyer.isSunk());
		assertEquals(1, ocean.getHitCount());
		assertEquals(0, ocean.getShipsSunk());
		
		//TODO
		//More tests

    // sink a ship
    assertTrue(ocean.shootAt(0, 5));
		assertTrue(destroyer.isSunk());
		assertEquals(2, ocean.getHitCount());
		assertEquals(1, ocean.getShipsSunk());

    // shoot a sunk ship
    assertFalse(ocean.shootAt(0, 5));
		assertTrue(destroyer.isSunk());
		assertEquals(3, ocean.getHitCount());
		assertEquals(1, ocean.getShipsSunk());

    // shoot an EmptySea
    assertFalse(ocean.shootAt(0, 0));
		assertEquals(3, ocean.getHitCount());
		assertEquals(1, ocean.getShipsSunk());

    // place another ship and sink it
    Submarine submarine = new Submarine();
		row = 2;
		column = 3;
		horizontal = false;
		submarine.placeShipAt(row, column, horizontal, ocean);
		
    assertEquals(3, ocean.getHitCount());
		assertEquals(1, ocean.getShipsSunk());

    assertTrue(ocean.shootAt(2, 3));
    assertEquals(4, ocean.getHitCount());
		assertEquals(2, ocean.getShipsSunk());
	}

	@Test
	void testGetShipArray() {
		
		Ship[][] shipArray = ocean.getShipArray();
		assertEquals(OCEAN_SIZE, shipArray.length);
		assertEquals(OCEAN_SIZE, shipArray[0].length);
		
		assertEquals("empty", shipArray[0][0].getShipType());
		
		//TODO
		//More tests

    // place an destroyer and a submarine
    Destroyer destroyer = new Destroyer();
		int row = 1;
		int column = 5;
		boolean horizontal = false;
		destroyer.placeShipAt(row, column, horizontal, ocean);
    
    Submarine submarine = new Submarine();
		row = 2;
		column = 3;
		horizontal = false;
		submarine.placeShipAt(row, column, horizontal, ocean);

    assertEquals("empty", shipArray[0][0].getShipType());
    assertEquals("destroyer", shipArray[1][5].getShipType());
		assertEquals("destroyer", shipArray[0][5].getShipType());
		assertEquals("submarine", shipArray[2][3].getShipType());

    assertFalse(shipArray[1][5].isSunk());
    assertFalse(shipArray[0][5].isSunk());
    assertFalse(shipArray[2][3].isSunk());

    // sink a ship and check if it is reflected in the shipArray
  
    assertTrue(ocean.shootAt(2, 3));
    assertEquals(1, ocean.getHitCount());
		assertEquals(1, ocean.getShipsSunk());

		assertEquals("submarine", shipArray[2][3].getShipType());
    assertTrue(shipArray[2][3].isSunk());
	}

}
