package battleship;

/**
 * submarine: describes a ship of length 1, and has the ship type 
 */
public class Submarine extends Ship {
	public static final int LENGTH = 1;
	public static final String TYPE = "submarine";
	
  // submarine length 
	public Submarine() {
		super(LENGTH);
}

  // override to get submarine ship type 
	@Override
	public String getShipType() {
		return TYPE;
	}
}
