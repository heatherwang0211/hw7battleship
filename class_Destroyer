package battleship;

/**
 * destroyer: describes a ship of length 2, and has the ship type 
 */
public class Destroyer extends Ship {
	public static final int LENGTH = 2;
	public static final String TYPE = "destroyer";
	
  // destroyer length 
	public Destroyer() {
		super(LENGTH);
}

  // override to get destroyer ship type 
	@Override
	public String getShipType() {
		return TYPE;
	}
}
