package battleship;

/**
 * battleship: describes a ship of length 4, and has the ship type 
 */
public class Battleship extends Ship {
	public static final int LENGTH = 4;
	public static final String TYPE = "battleship";
	
  // battleship length 
	public Battleship() {
		super(LENGTH);
	}
	
  // override to get battleship type 
	@Override
	public String getShipType() {
		return TYPE; 
	}
}
