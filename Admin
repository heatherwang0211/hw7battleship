	/**
	 * Adds a course to the professor's academic plan
	 * 
	 * @param courseID
	 * @param professor
	 * @throws Exception
	 */
	public void addCourseToProfessor(String courseID, Professor professor, ArrayList<Course> coursesCatalog) throws Exception {
	    String cleanedCourseID = Course.cleanCourseName(courseID);
	    Course courseToAdd = getCourseObject(cleanedCourseID, coursesCatalog);

	    if (courseToAdd != null) { // if we got a course, we need to loop through eachone and compare IDs
	        boolean courseAdded = false; 
	        for (Course c : professor.getEditableCourses()) {
	            if (c.getCourseID().equals(cleanedCourseID)) {
	            	courseAdded = true; // stop the process before we add a duplicate
	                break;
	            }
	        }
	        if (!courseAdded) {
	            professor.addCourse(cleanedCourseID, coursesCatalog);
	            System.out.println(cleanedCourseID + " has been added to the Professor's schedule.");
	        } else {
	            System.out.println(
	                    cleanedCourseID + " is already present in the Professor's schedule and thus was not added.");
	        }
	    } else {
	        System.out.println("Course " + cleanedCourseID + " does not exist in the course catalog.");
	    }
	}

	/**
	 * Adds a course to the student's academic plan
	 * 
	 * @param courseID
	 * @param student
	 */
	public void addCourseToStudent(String courseID, Student student, ArrayList<Course> coursesCatalog) {
	    String cleanedCourseID = Course.cleanCourseName(courseID);
	    Course courseToAdd = getCourseObject(cleanedCourseID, coursesCatalog); // grab the course object

	    if (courseToAdd != null) { // if we got a course, we need to loop through eachone and compare IDs
	        boolean courseAdded = false;
	        for (Course course : student.getEditableCourses()) {
	            if (course.getCourseID().equals(cleanedCourseID)) {
	            	courseAdded = true; // stop the process before we add a duplicate
	                break;
	            }
	        }
	        if (!courseAdded) {
	            student.addCourse(cleanedCourseID, coursesCatalog);
	            System.out.println(cleanedCourseID + " has been added to the student's schedule.");
	        } else {
	            System.out.println(
	                    cleanedCourseID + " is already present in the student's schedule and thus was not added.");
	        }
	    } else {
	        System.out.println(cleanedCourseID + " does not exist in the course catalog.");
	    }
	}

