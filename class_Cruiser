package battleship;

/**
 * cruiser: describes a ship of length 3, and has the ship type 
 */
public class Cruiser extends Ship {
	public static final int LENGTH = 3;
	public static final String TYPE = "cruiser";
	
  // cruiser length 
	public Cruiser() {
		super(LENGTH);
	}
	
  // override to get cruiser type 
	@Override
	public String getShipType() {
		return TYPE; 
}
}
