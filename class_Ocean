package battleship;
import java.util.Random;

public class Ocean {
	
	/**
	 * Used to quickly determine which ship is in any given location 
	 */
    private Ship[][] ships = new Ship[10][10]; 
    
	/**
	 * The total number of shots fired by the user
	 */
    private int shotsFired; 
    
	/**
	 * The number of times a shot hit a ship
	 */
    private int hitCount; 
    
	/**
	 * The number of ships sunk (10 ships in all)
	 */
    private int shipsSunk; 
    
    
//    // set ship types with predetermined lengths (Battleship: 4, Cruiser: 3, Destroyer: 2, Submarine: 1)
//    private static final Ship[] SHIP_TYPES = {
//        new Battleship(),
//        new Cruiser(), 
//        new Destroyer(), 
//        new Submarine(), 
//    };
    
    /**
     * creates an empty ocean and fills ship array with emptysea objects 
     * initialize any game variables such as how many shots have been fired 
     */
    public Ocean()  {
    	
    	// Fill the grid with EmptySea 
    	//ships = new Ship[10][10]; It is initialized already.
    	for (int row = 0; row < ships.length; row ++) {
    		for (int col = 0; col < ships[row].length; col ++) {
          ships[row][col] = new EmptySea();
    			ships[row][col].placeShipAt(row, col, false, this);

    		}
    	}
    	
    	// All int variable is set as 0 by default 
    	// initially no shots are fired 	
    	shotsFired = 0;
 
    }
   
    /**
     * Place 10 ships randomly
     */
    
    public void placeAllShipsRandomly() {
        
    	
    	Ship[] fleets = {
                new Battleship(),        // 1 Battleship
                new Cruiser(), new Cruiser(), // 2 Cruiser
                new Destroyer(), new Destroyer(), new Destroyer(), // 3 Destroyer
                new Submarine(), new Submarine(), new Submarine(), new Submarine() // 4 Submarine
            };
    	
    	Random random = new Random();
        
        for (Ship ship: fleets) {
        	while (true) {
                int row = random.nextInt(10);
                int col = random.nextInt(10);
                boolean randomOrientation = random.nextBoolean();

                // Place the ship if the spot is empty and legal
                if (ships[row][col] instanceof EmptySea && ship.okToPlaceShipAt(row, col, randomOrientation, this)) {
                	ship.placeShipAt(row, col, randomOrientation, this);
                	break;
                }
            }
        }
    }
    
    /**
     * return true if given location contains a ship, false if not 
     * @param row
     * @param column
     * @return
     */
    public boolean isOccupied(int row, int col) {
	  
	   if (ships[row][col] instanceof EmptySea) {
		   return false;
	   }
	   else {
		   return true;
	   }
   }
    /**
     * return true if given location contains a real ship that is not sunk. 
     * @param row
     * @param column
     * @return
     */
    boolean shootAt(int row, int col) {
        
    	shotsFired++;
    	Ship targetShip = ships[row][col];

    	// conduct the shot if not sunk
    	if(!targetShip.isSunk()) { 
    		
    		if(targetShip.shootAt(row, col)){ //targetShip.shootAt only return true if it is real ship and it is hit
    			
    			hitCount++;
    			System.out.println("Hit.");
    			
    			if(targetShip.isSunk()) { // additional check if the ship is just sunk
    				shipsSunk++;
    				System.out.println("You just sank a ship - " + targetShip.getShipType());
    			}
    			
    			return true; // return true if shootAt is successful 
    		}
    		else {   // targetShip.shootAt return false if shot an emptySea)
    			System.out.println("Miss.");
    			return false;
    		}
    	}
    	
    	// if it is sunk, a real ship is hit, hitCount++
        else {
        	hitCount++;
        	System.out.println("Hit.");
        	return false;
        }
    }

    /**
     * return number of shots fired in game 
     * @return
     */
    int getShotsFired() {
    	return shotsFired;
    }
    
    /**
     * return number of hits recorded in game 
     * @return
     */
    int getHitCount() {
    	return hitCount;
    }
    
    /**
     * return number of ships sunk in game 
     * @return
     */
    int getShipsSunk() {
    	return shipsSunk;
    }
    
    /**
     * true if all ships have been sunk, otherwise false 
     * @return
     */
    boolean isGameOver() {
    	return shipsSunk == 10;
    }
    
    /**
     * return the 10x10 array of ships, take Ocean parameter and need to be able to look at the contents of this array 
     * placeShipAt() method needs to modify this. 
     * allow methods in one class to directly access instance var in another class - not ideal but no alternative 
     * @return
     */
   public Ship[][]getShipArray() {
    	return ships;
    }
    
    /**
     * prints the ocean status - numbers should be displayed 1 to 10 not 0 to 9 
     * top left is 0,0 
     * x means fired upon and hit a ship 
     * - means fired upon and nothing there 
     * s means sunken ship 
     * . means never fired upon 
     */
   public void print() {
	   
	   // print column index
	   System.out.print("  "); // Space for the top-left corner
	   for (int i = 0; i<10; i++) {
		   System.out.print(i +" ");
	   }
	   
	   System.out.println(); // new line
	
	   for (int row = 0; row < ships.length; row++) {
		   System.out.print(row + " ");
		   for (int col = 0; col <ships[row].length; col++) {
			   
			   Ship thisShip = ships[row][col];
			   boolean isShot = false;
			   
			   // check if this location is shot at 
			   // If it is a real ship, check which part of the ship it is and hit index
			   if (this.isOccupied(row, col)) {
				   
				   int hitIndex;
				   
				   if (thisShip.isHorizontal()) {
					   hitIndex = thisShip.getBowColumn() - col;
				   } 
				   else {
					   hitIndex = thisShip.getBowRow() - row;
				   }
				   
				   isShot = thisShip.getHit()[hitIndex];		      
			   }
			   
			   // If it is EmptySea, get hit index
			   else {
				   isShot = thisShip.getHit()[0];
			   }
			 
			   // perform print
			   if(isShot) {
				   System.out.print(thisShip);
				   System.out.print(" ");
	            } else {
	                System.out.print(". "); 
	            }
		   }
		   System.out.println(" ");
	   }
		   
	   
    }
	
	
    /**
     * used for debugging - shows location of the ships 
     * b means battleship
     * c means cruiser 
     * d means destroyer 
     * s means submarine 
     * ' ' means empty sea (single space) 
     */
    void printWithShips() {
 	   
    	// print column index
 	   System.out.print("  "); // Space for the top-left corner
 	   for (int i = 0; i<10; i++) {
 		   System.out.print(i +" ");
 	   }
 	   
 	   System.out.println(); // move to next line
 	
	   for (int row = 0; row < ships.length; row++) {
		   System.out.print(row + " "); //styling , print row index and a space 
		   
		   for (int col = 0; col <ships[row].length; col++) {
			   
			   Ship thisShip = ships[row][col];
			   
			   if ("battleship".equals(thisShip.getShipType())){
				  System.out.print("b ");
			   } 
			   else if ("cruiser".equals(thisShip.getShipType())){
				  System.out.print("c ");				   
			   }
			   else if ("destroyer".equals(thisShip.getShipType())){
				  System.out.print("d ");				   
			   }
			   else if ("submarine".equals(thisShip.getShipType())){
				  System.out.print("s ");				   
			   }
			   else if ("empty".equals(thisShip.getShipType())){
				  System.out.print("  ");				   
			   }
		   }
		   System.out.println(" ");
	   }
    }

}
