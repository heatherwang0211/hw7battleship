package battleship;
import java.util.Scanner;
public class BattleshipGame {
	
	
	/**
	 * Create instance of ocean
	 */
	private Ocean ocean = new Ocean();
	
	/**
	 * get the ships from the instance of ocean
	 */
	private Ship[][] ships = ocean.getShipArray();
	
	/**
	 * Get target input from user
	 * @return
	 */
	int[] inputTarget() {
		
		Scanner scan = new Scanner(System.in);
		int row;
		int col;
		
		while(true) {
			System.out.print("Enter row, column: "); // expected input is like 2,3
			String userInput = scan.nextLine();
			String[] userInputArray = userInput.split(",");
			
           try {
               row = Integer.parseInt(userInputArray[0].trim());
               col = Integer.parseInt(userInputArray[1].trim());
              
               if(row >= 0 && row <= 9 && col <= 9 && col >=0 ) {
               	int[] result = {row, col};
               	return result;
               }
               else {
                   System.out.println("Please enter valid range between 0 to 9.");
               }
              
           } catch (ArrayIndexOutOfBoundsException e) {
               System.out.println("Please enter two integers separated by a comma.");
           }
		}	
	}
	
	/**
	 * perform a shot at a given location
	 */
	void makeOneShot() {
		
		// get target Ship, row and col
		int[] target = this.inputTarget();
		int targetRow = target[0];
		int targetCol = target[1];
		Ship targetShip = this.ships[targetRow][targetCol];
		
		ocean.shootAt(targetRow, targetCol);
		
//		System.out.println("Debug: in hit array, the first boolean is " + targetShip.getHit()[0]);//debug
//		System.out.println("Debug: isSunk for this ship is" + targetShip.isSunk());//debug
//		System.out.println("Debug: shipsSunk" + ocean.getShipsSunk());//debug
	}
	
	/**
	 * main method for game control. Human shots at each location. Game over until all of the 10 ships are sunk.
	 * @param args
	 */
	
	public static void main(String[] args) {
		
		BattleshipGame game = new BattleshipGame();
		
		game.ocean.placeAllShipsRandomly();
		
		System.out.println("Welcome to the battleship game, below is your 10x10 ocean.");
		System.out.println(" ");

		while(!(game.ocean.isGameOver())){
			
			game.ocean.printWithShips(); //debug
			game.ocean.print();
			game.makeOneShot();	
		}
		
		System.out.println("Game over, your score is" + game.ocean.getShotsFired());
	}
}
