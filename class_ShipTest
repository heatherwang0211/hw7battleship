	@Test
	void testOkToPlaceShipAt() {
		
		//test when other ships are not in the ocean
		Ship battleship = new Battleship();
		int row = 0;
		int column = 4;
		boolean horizontal = true;
		boolean ok = battleship.okToPlaceShipAt(row, column, horizontal, ocean);
		assertTrue(ok, "OK to place ship here.");
		
		//test when there is a ship and placing second ship, OK to place  
		Ship destroyer = new Destroyer();
		int rowD = 7;
		int columnD = 7;
		boolean horizontalD = false;
		boolean okD = destroyer.okToPlaceShipAt(rowD, columnD, horizontalD, ocean);
		assertTrue(okD, "OK to place destroyer here.");
		
		// test when there are two ships and placing third ship, NOT OK to place 
		Ship cruiser = new Cruiser();
		int rowC = 7;
		int columnC = 8;
		boolean horizontalC = false;
		boolean okC = cruiser.okToPlaceShipAt(rowC, columnC, horizontalC, ocean);
		assertTrue(okC, "NOT OK to place cruiser here, already something placed here.");
		
	}
	
	@Test
	void testOkToPlaceShipAtAgainstOtherShipsOneBattleship() {
		
		//test when other ships are in the ocean
		
		//place first ship
		Battleship battleship1 = new Battleship();
		int row = 0;
		int column = 4;
		boolean horizontal = true;
		boolean ok1 = battleship1.okToPlaceShipAt(row, column, horizontal, ocean);
		assertTrue(ok1, "OK to place ship here.");
		battleship1.placeShipAt(row, column, horizontal, ocean);

		//test second ship
		Battleship battleship2 = new Battleship();
		row = 1;
		column = 4;
		horizontal = false;
		boolean ok2 = battleship2.okToPlaceShipAt(row, column, horizontal, ocean);
		assertFalse(ok2, "Not OK to place ship vertically adjacent below.");
		
		// test second ship placing: placing far away, OK
		Battleship battleship3 = new Battleship();
		row = 10;
		column = 7;
		horizontal = true;
		boolean ok3 = battleship3.okToPlaceShipAt(row, column, horizontal, ocean);
		assertFalse(ok3, "OK to place horizontal ship far below.");
		
		// test third ship placing: placing right next to second ship successfully placed, NOT OK
		Cruiser cruiser = new Cruiser();
		row = 10;
		column = 8;
		horizontal = false;
		boolean okC = cruiser.okToPlaceShipAt(row, column, horizontal, ocean);
		assertFalse(okC, "Not OK to place vertical cruiser next to battleship3."); //failing - expected false but was true
		
		// test third ship placing: far away, OK
		Cruiser cruiser2 = new Cruiser();
		row = 3;
		column = 7;
		horizontal = true;
		boolean okC2 = cruiser2.okToPlaceShipAt(row, column, horizontal, ocean);
		assertTrue(okC2, "OK to place horizontal cruiser far from every other ship.");
	}

	@Test
	void testPlaceShipAt() {
		
		// Provided test: test placing battleship
		Ship battleship = new Battleship();
		int row = 0;
		int column = 4;
		boolean horizontal = true;
		battleship.placeShipAt(row, column, horizontal, ocean);
		assertEquals(row, battleship.getBowRow());
		assertEquals(column, battleship.getBowColumn());
		assertTrue(battleship.isHorizontal());
		
		assertEquals("empty", ocean.getShipArray()[0][0].getShipType());
		assertEquals(battleship, ocean.getShipArray()[0][1]);
		

		//added test: test placing cruiser and test around it to detect ship and empty sea
		Ship cruiser = new Cruiser();
		int rowC = 7;
		int columnC = 7;
		boolean horizontalC = true;
		cruiser.placeShipAt(rowC, columnC, horizontalC, ocean);
		assertEquals(rowC, cruiser.getBowRow());
		assertEquals(columnC, cruiser.getBowColumn());
		assertTrue(cruiser.isHorizontal());
		
		assertEquals("empty", ocean.getShipArray()[6][7].getShipType());
		assertEquals(cruiser, ocean.getShipArray()[7][6]);
		
		//added test: test placing destroyer and detect around it for ship and empty sea
		Ship destroyer = new Destroyer();
		int rowD = 3;
		int columnD = 9;
		boolean horizontalD = false;
		destroyer.placeShipAt(rowD, columnD, horizontalD, ocean);
		assertEquals(rowD, destroyer.getBowRow());
		assertEquals(columnD, destroyer.getBowColumn());
		assertFalse(destroyer.isHorizontal());
		
		assertEquals("empty", ocean.getShipArray()[3][1].getShipType());
		assertEquals(destroyer, ocean.getShipArray()[2][9]);
	}

	@Test
	void testShootAt() {
		
		// provided test: test shooting at battleship 
		Ship battleship = new Battleship();
		int row = 0;
		int column = 9;
		boolean horizontal = true;
		battleship.placeShipAt(row, column, horizontal, ocean);
		
		assertFalse(battleship.shootAt(1, 9));
		boolean[] hitArray0 = {false, false, false, false};
		assertArrayEquals(hitArray0, battleship.getHit());
		
		//added test: test shooting at submarine - true
		Ship submarine = new Submarine();
		int rowS = 3;
		int columnS = 7;
		boolean horizontalS = true;
		submarine.placeShipAt(rowS, columnS, horizontalS, ocean);
		
		assertTrue(submarine.shootAt(3, 7));
		boolean[] hitArray1 = {true};
		assertArrayEquals(hitArray1, submarine.getHit());
		
		// added test: test shooting at destroyer - true 
		Ship destroyer = new Destroyer();
		int rowD = 5;
		int columnD = 5;
		boolean horizontalD = false;
		destroyer.placeShipAt(rowD, columnD, horizontalD, ocean);
		
		assertTrue(destroyer.shootAt(5, 4)); // failing - expected true but was false 
		boolean[] hitArray2 = {false, true};
		assertArrayEquals(hitArray2, destroyer.getHit());
	}
	
	@Test
	void testIsSunk() {
		
		// Provided test: test isSunk for submarine 
		Ship submarine = new Submarine();
		int row = 3;
		int column = 3;
		boolean horizontal = true;
		submarine.placeShipAt(row, column, horizontal, ocean);
		
		assertFalse(submarine.isSunk());
		assertFalse(submarine.shootAt(5, 2));
		assertFalse(submarine.isSunk());
		
		//added test: test isSunk for battleship - should sink as it shoots all
		Ship battleship = new Battleship();
		int rowB = 8;
		int columnB = 8;
		boolean horizontalB = false;
		battleship.placeShipAt(rowB, columnB, horizontalB, ocean);
		
		assertFalse(battleship.isSunk());
		assertTrue(battleship.shootAt(8, 8)); 
		assertTrue(battleship.shootAt(8, 7)); //failing - expected true but was false
		assertTrue(battleship.shootAt(8, 6));
		assertTrue(battleship.shootAt(8, 5));
		assertTrue(battleship.isSunk());
		
		//added test: test isSunk for destroyer 
		Ship destroyer = new Destroyer();
		int rowD = 5;
		int columnD = 5;
		boolean horizontalD = true;
		destroyer.placeShipAt(rowD, columnD, horizontalD, ocean);
		
		assertFalse(submarine.isSunk());
		assertTrue(submarine.shootAt(5, 5));
		assertTrue(submarine.shootAt(4, 5));
		assertTrue(submarine.isSunk());
	}

