package battleship;

public abstract class Ship {
	  // the row that contains the bow (front of the ship)
	  private int bowRow; 
	
	  // the column that contains the bow (front of the ship) 
    private int bowColumn; 
    
    // the length of the ship 
    private int length; 
    
    // represents whether the ship is going to be placed horizontally or vertically 
    private boolean horizontal; 
    
    // boolean array indicating whether the ship part is hit or not 
    private boolean[] hit; 
    
    /**
     * sets the length property of the ship and initializes the hit array based on that length 
     * @param length of ship 
     */

    public Ship (int length) {
    	// initialize the length to this length 
    	this.length = length; 
    	// initialize the hit boolean to this, based on the length of the ship 
    	this.hit = new boolean[length];
    }
    
    // GETTERS 
    
    /**
     * returns the ship length 
     * @return ship length
     */
    public int getLength() {
    	return length;
    }
    
    /**
     * returns the row corresponding to the position of the bow 
     * @return bow's row 
     */
    public int getBowRow() {
    	return bowRow;
    }
    
    /** 
     * returns bow column location 
     * @return bow's column 
     */ 
    public int getBowColumn() {
    	return bowColumn;
    }
    
    /**
     * returns the hit array 
     * @return the array that has been hit 
     */
    public boolean[] getHit() {
    	return hit;
    }
    
    /**
     * returns whether the ship is horizontal or not 
     * @return true if horizontal, false if vertical 
     */
    public boolean isHorizontal() {
    	return horizontal;
    }
    
    // SETTERS
    /**
     * sets the value of bowRow 
     * @param row of the ship's bow 
     */
    public void setBowRow(int row) {
    	this.bowRow = row;
    }
    
    /**
     * sets the value of bowColumn 
     * @param column of the ship's bow 
     */
    public void setBowColumn(int column) {
    	this.bowColumn = column;
    }
    
    /**
     * sets the value of the instance variable horizontal 
     * @param horizontal it gets the true false value of whether the ship is horizontal or not 
     */
    public void setHorizontal (boolean horizontal) {
    	this.horizontal = horizontal; 
    }
    
    /**
     * every type of ship has to override and implement and return the corresponding ship type 
     * since it will get overridden by the extended methods, this one does not have a body 
     * @return type of ship as a string 
     */
    public abstract String getShipType();
    
    /**
     * based on the conditions, returns whether a ship can be placed at this location 
     * @param row to be placed at 
     * @param column to be placed at 
     * @param horizontal true if horizontal, false if vertical 
     * @param ocean to get ship array 
     * @return true if can be placed, false if not 
     */
    boolean okToPlaceShipAt(int row, int column, boolean horizontal, Ocean ocean) {
    	// set the maximum valid indexes in ocean
    	// arrays are 0-indexed, so if 10 rows the max is actually 10-1 = 9  
    	int maxRow = ocean.getShipArray().length -1;
    	// get the first row and its max length 
    	int maxCol = ocean.getShipArray()[0].length -1;
    	
    	// if ship horizontal, check if a ship can be placed there 
    	if (horizontal) {
    		// if horizontal, ship extends across multiple columns  
    		// check if row is between the leftmost and rightmost, and within the length of the ship 
        // check if col and row numbers are within max and min 
    		if ( column < 0 || row < 0 || row > maxRow || column - (length - 1) < 0 ) {
    			// cannot place ship if any of conditions is not met 
    			return false;
    		}
    	}
    		// if ship is vertical, check if can place ship there 
    		if (!horizontal) {
    			// if vertical, ship extends across multiple rows 
    			// check if column is between highest and lowest boundaries
          // check if col and row numbers are within max and min
    			if ( row < 0 || column < 0 || column > maxCol || row - (length - 1 ) < 0 ) {
    				// cannot place ship if any conditions not met 
    				return false;
    			}
        }
    	// iterate over the ship 
    	for (int i = 0; i < length; i ++ ) {
    		int thisRow, thisColumn;
    		// if horizontal 
    		if (horizontal) {
    			//then this row currently is where the ship will be for the whole ship 
    			thisRow = row; 
    			// the ship will be placed facing right, the column decreases from the bow (moving left)
    			thisColumn = column - i;
    			// iterate over rows for every column 
        		// for every row within the scope, check beside it up and down 
        		for (int r = thisRow - 1; r <= thisRow + 1; r ++) {
        			// for every column within the scope, check beside it left and right 
        			for (int c = thisColumn - 1; c <= thisColumn + 1; c ++) {
        				// if row checked is within bounds, and column checked is within bounds 
        				if (r >= 0 && r <= maxRow && c >= 0 && c <= maxCol) {
        					// and if the ship's array is NOT part of the emptysea class, 
        					// meaning the ship is a real existing ship not emptysea 
        					// it is NOT OK to place ship there 
        					if  (!(ocean.getShipArray()[r][c] instanceof EmptySea)) {
        						return false;
        					}
        				}
        			}
        		}
    		}
    		// if vertical 
    		if (!horizontal) {
    			// this row will not be where all the ship will be 
    			// this ship will be placed vertically faces south, the row decreases from the bow (moving up)
    			thisRow = row - i;
    			//then this column currently is where the ship will be for the whole ship
    			thisColumn = column;
    			// iterate over rows for every column 
        		// for every row within the scope, check beside it up and down 
        		for (int r = thisRow - 1; r <= thisRow + 1; r ++) {
        			// for every column within the scope, check beside it left and right 
        			for (int c = thisColumn - 1; c <= thisColumn + 1; c ++) {
        				// if row checked is within bounds, and column checked is within bounds 
        				if (r >= 0 && r <= maxRow && c >= 0 && c <= maxCol) {
        					// and if the ship's array is NOT part of the emptysea class, 
        					// meaning the ship is a real existing ship not emptysea 
        					// it is NOT OK to place ship there 
        					if  (!(ocean.getShipArray()[r][c] instanceof EmptySea)) {
        						return false;
        					}
        				}
        			}
        		}
    		}   
    	}
    	// if none of the above checks returned false, then it is OK to place the ship there 
    	return true; 
    	} 
    	

    /**
     * puts the ship in the ocean at a location 
     * @param row of ship bow 
     * @param column of ship bow 
     * @param horizontal ship orientation - horizontal if true, vertical if false 
     * @param ocean to be placed on, holds ship array 
     */
    void placeShipAt(int row, int column, boolean horizontal, Ocean ocean) {
    	// set ship row, column, and orientation 
    	setBowRow(row);
    	setBowColumn(column);
    	setHorizontal(horizontal);
    	
    	//if ship is horizontal 
    	if (horizontal) {
    		// iterate over the location starting from 0 to end of the ship 
    		for (int i = 0; i < length; i ++ ) {
    			// this column is the bow column minus length, if ship is horizontal - extending right to left  
    			int thisColumn = column - i; 
          // if this column is within range of the ocean 
    			if (thisColumn >= 0 ) {
    			// ship placement in ocean is exact the row for horizontal, column is decreasing from the bow moving right to left
    			ocean.getShipArray()[row][thisColumn] = this;   
    			}
    			
    			else {
            // if the column number is out of range, throw exception 
    				throw new IllegalArgumentException("Column index out of bound.");
    			}
    	}
    	}
    	// if ship is vertical 
    	if (!horizontal) {
    		// iterate over the location starting from 0 to length 
    		for (int i = 0; i < length; i ++ ) {
    			// this row is the bow row minus length, if ship is vertical - extending bottom to top 
    			int thisRow = row - i;
          // if this row is within range of the ocean 
    			if (thisRow >= 0 ) {
    			// ship placement in ocean is exact column for vertical, row decreasing from bow moving up/ number descending 
    			ocean.getShipArray()[thisRow][column] = this;
    			}
    			
    			else {
            // if the row number is out of bound, throw an exception
    				throw new IllegalArgumentException("Row index out of bound.");
    			}
    			
    		}
    	}
    }


    /**
     * this method marks a ship as being hit if the ship is at a certain row or column 
     * this method also marks the part of the ship that is shot as HIT, return as true 
     * @param row of the location shot at 
     * @param column of the location shot at 
     * @return true if ship can be shot at, false if ship cannot be shot at 
     */
    boolean shootAt(int row, int column) { 
    	
    	// first check if the boat is still afloat 
    	// if not afloat then return false because it cannot be shot at 
    	if (isSunk()) { 
    			return false; 
    	}

      // initialize where on the ship it is shot 
    	int indexShotOnShip; 
    	// if ship is horizontal
    	if (horizontal) {
    		// if the row shot at is not the same row as the ship placement 
    		// if the column is not within the columns the ship is placed on  
    		// then it is false because it cannot be shot at 
    		if (row != bowRow || column > bowColumn || column < bowColumn - (length - 1) ) {
    			return false; 
    		} 
    		 
    		// else update where on the ship it is shot 
    		indexShotOnShip = bowColumn - column;
    	}
    	// if the ship is vertical 
    	else {
    		// if column shot is not the same column as the ship placement 
    		// if the row is not within the range the ship is placed on 
    		// then it cannot be shot at 
    		if (column != bowColumn || row > bowRow || row < bowRow  - (length - 1)) {
    			return false; 
    		}  
        // else update where on the ship it is shot 
    		indexShotOnShip = bowRow - row;
    	} 
    	
      // update the boolean of hit to be true if it is hit and return it 
    	hit[indexShotOnShip] = true; 
    	return true;
    	}
    	
    

    /**
     * checks if the ship has been sunk 
     * @return true if every part of the ship has been hit, false otherwise 
     */
    boolean isSunk() {
    	 
    	// access hit array and assign to hitShip to use 
    	boolean [] hitShip = getHit(); 
    	// iterate through each part of the ship to see if it is hit  
    	for ( int i = 0; i < hitShip.length; i++) {
    		// if ANY PART while iterating, is NOT hit
    		if (!hitShip[i]) {
    			// return false 
    			return false;
    		}
    	}
    	// if every part is hit, return true 
    	return true;
    }
    
    /**
     * toString method to display on the game grid after each round 
     @return single character string to use in the ocean print method 
     */
    @Override 
    public String toString() {
    	// if sunk, return s for sunk
    	if (isSunk()) {
    		return "s";
    	}
    	// if not sunk, return x for ship still there but has been hit, marking the location that has been hit 
    	if (!isSunk()) {
    		return "x";
    	}

      // there should not be another case, but in case isSunk somehow does not provide an output, return null and inform user 
    	System.out.println("Unexpected, ship not sunk or hit.");
    	return null;
    }

} 
