package battleship;

public abstract class Ship {
	// the row that contains the bow (front of the ship)
	private int bowRow; 
	
	// the column that contains the bow (front of the ship) 
    private int bowColumn; 
    
    // the length of the ship 
    private int length; 
    
    // represents whether the ship is going to be placed horizontally or vertically 
    private boolean horizontal; 
    
    // boolean array indicating whether the ship part is hit or not 
    private boolean[] hit; 
    
    /**
     * sets the length property of the ship and initializes the hit array based on that length 
     * @param length
     */
    public Ship (int length) {
    	// initialize the length to this length 
    	this.length = length; 
    	// initialize the hit boolean to this, based on the length of the ship 
    	this.hit = new boolean[length];
    }
    
    // GETTERS 
    
    /**
     * returns the ship length 
     * @return
     */
    public int getLength() {
    	return length;
    }
    
    /**
     * returns the row corresponding to the position of the bow 
     * @return
     */
    public int getBowRow() {
    	return bowRow;
    }
    
    /** 
     * returns bow column location 
     * @return
     */
    public int getBowColumn() {
    	return bowColumn;
    }
    
    /**
     * returns the hit array 
     * @return
     */
    public boolean[] getHit() {
    	return hit;
    }
    
    /**
     * returns whether the ship is horizontal or not 
     * @return
     */
    public boolean isHorizontal() {
    	return horizontal;
    }
    
    // SETTERS
    /**
     * sets the value of bowRow 
     * @param row
     */
    public void setBowRow(int row) {
    	this.bowRow = row;
    }
    
    /**
     * sets the value of bowColumn 
     * @param column
     */
    public void setBowColumn(int column) {
    	this.bowColumn = column;
    }
    
    /**
     * sets the value of the instance variable horizontal 
     * @param horizontal
     */
    public void setHorizontal (boolean horizontal) {
    	this.horizontal = horizontal; 
    }
    
    /**
     * every type of ship has to override and implement and return the corresponding ship type 
     * since it will get overridden by the extended methods, this one does not have a body 
     * @return type of ship as a string 
     */
    public abstract String getShipType();
    
    
    /**
     * based on the conditions, returns whether a ship can be placed at this location 
     * @param row
     * @param column
     * @param horizontal
     * @param ocean
     * @return
     */
    boolean okToPlaceShipAt(int row, int column, boolean horizontal, Ocean ocean) {
    	// set the maximum valid indexes in ocean
    	// arrays are 0-indexed, so if 10 rows the max is actually 10-1 = 9  
    	int maxRow = ocean.getShipArray().length -1;
    	// get the first row (could be any but use first for convenience) 
    	int maxCol = ocean.getShipArray()[0].length -1;
    	
    	// if ship horizontal, check if can place ship there 
    	if (horizontal) {
    		// if horizontal, ship extends across multiple columns 
    		// max column minus ship length should be more than 0 to fit in 
    		// say, ship of length 3 is taking up 2 more spots to the left (length - 1)
    		// the columns total - how many more columns needed cannot be less than 0 
    		// check if row is between the max and min 
    		if ( column < 0 || row < 0 || row > maxRow || column - (length - 1) < 0 ) {
    			// cannot place ship if any of conditions not met 
    			return false;
    		}
    	}
    		// if ship is vertical, check if can place ship there 
    		if (!horizontal) {
    			// if vertical, ship extends across multiple rows 
    			// max row minus ship length should be more than 0 to fit in  
    			// say, ship of length 3 is taking up 2 more spots to the top (length - 1)
    			// then, the row total - how many more needed needs to be more than 0 
    			// ensure the column is between the max and min
    			if ( row < 0 || column < 0 || column > maxCol || row - (length - 1 ) < 0 ) {
    				// cannot place ship if any conditions not met 
    				return false;
    			}
    		}
    	 
    	
    	// iterate over the whole ship, in all of its length 
    	for (int i = 0; i < length; i ++ ) {
    		int thisRow, thisColumn;
    		// if horizontal 
    		if (horizontal) {
    			//then this row currently is where the ship row will be for the whole ship 
    			thisRow = row; 
    			// then this column is NOT where all the ship will be
    			// the ship will take place facing right, the column decreases from the bow (moving left)
    			thisColumn = column - i;
    			// iterate over rows for every column 
        		// for every row within the scope, check next to it up and down 
        		for (int r = thisRow - 1; r <= thisRow + 1; r ++) {
        			// for every column within the scope, check next to it left and right 
        			for (int c = thisColumn - 1; c <= thisColumn + 1; c ++) {
        				// if row checked is within bounds, and column checked is within bounds 
        				if (r >= 0 && r <= maxRow && c >= 0 && c <= maxCol) {
        					// and if the ship's array is NOT part of the emptysea class, 
        					// meaning the ship is a real existing ship not emptysea 
        					// it is NOT OK to place ship there 
        					if  (!(ocean.getShipArray()[r][c] instanceof EmptySea)) {
        						return false;
        					}
        				}
        			}
        		}
    		}
    		// if vertical 
    		if (!horizontal) {
    			// this row will not be where all the ship will be 
    			// this ship will take place at total row - ship length (vertical)
    			// we do minus because it faces south, the row decreases from the bow (moving up)
    			thisRow = row - i;
    			//then this column currently is where the ship will be for the whole ship
    			thisColumn = column;
    			// iterate over rows for every column 
        		// for every row within the scope, check next to it up and down 
        		for (int r = thisRow - 1; r <= thisRow + 1; r ++) {
        			// for every column within the scope, check next to it left and right 
        			for (int c = thisColumn - 1; c <= thisColumn + 1; c ++) {
        				// if row checked is within bounds, and column checked is within bounds 
        				if (r >= 0 && r <= maxRow && c >= 0 && c <= maxCol) {
        					// and if the ship's array is NOT part of the emptysea class, 
        					// meaning the ship is a real existing ship not emptysea 
        					// it is NOT OK to place ship there 
        					if  (!(ocean.getShipArray()[r][c] instanceof EmptySea)) {
        						return false;
        					}
        				}
        			}
        		}
    		} 
    	
    	}
    	// if none of the above checks returned false, then it is OK to place the ship there 
    	return true; 
    	
    	} 
    	
    
    	
    	
    
    /**
     * puts the ship in the ocean at a location 
     * @param row
     * @param column
     * @param horizontal
     * @param ocean
     */
    void placeShipAt(int row, int column, boolean horizontal, Ocean ocean) {
    	// set ship row, column, and orientation 
    	setBowRow(row);
    	setBowColumn(column);
    	setHorizontal(horizontal);
    	
    	//if ship is horizontal 
    	if (horizontal) {
    		// iterate over the location starting from 0 to length
    		for (int i = 0; i < length; i ++ ) {
    			
    			int thisColumn = column - i; 
    			if (thisColumn >= 0 ) {
    			// ship placement in ocean is exact the row for horizontal, column is decreasing from the bow moving left
    			ocean.getShipArray()[row][thisColumn] = this;   
    			}
    			
    			else {
    				throw new IllegalArgumentException("index out of bound");
    			}
    	}
    	}
    	// if ship is vertical 
    	if (!horizontal) {
    		// iterate over the location starting from 0 to length 
    		for (int i = 0; i < length; i ++ ) {
    			
    			int thisRow = row - i;
    			if (thisRow >= 0 ) {
    			// ship placement in ocean is exact column for vertical, row decreasing from bow because moving up/ number descending 
    			ocean.getShipArray()[thisRow][column] = this;
    			}
    			
    			else {
    				throw new IllegalArgumentException("row index out of bound");
    			}
    			
    		}
    	}
    }

    
 
    /**
     * this method marks a ship as being hit if the ship is at a certain row or column 
     * this method also marks the part of the ship that is shot as HIT, return as true 
     * @param row
     * @param column
     * @return
     */
    boolean shootAt(int row, int column) { 
    	
    	// first check if the boat is still afloat 
    	// if not afloat then return false because it cannot be shot at 
    	if (isSunk()) { 
    			return false; 
    	}
    	int indexShotOnShip; 
    	// if ship is horizontal - the placement of front is bowRow, bowColumn 
    	// the shot has to be the SAME as bowrow OR bowcolumn OR within the columns that make up the ship 
    	if (horizontal) {
    		// if the front coordinate is not the same as shot coordinate
    		// OR bc horizontal, extends across several columns, face east
    		// if the column shot at is bigger than column bigger than column
    		// then it is false because it cannot be shot at 
    		if (row != bowRow || column > bowColumn || column <= bowColumn - (length - 1) ) {
    			return false; 
    		} 
    		 
    		// else index of the shot part on the ship column
    		indexShotOnShip = bowColumn - column;
    		
    	}
    	// the shot has to be the SAME as bowrow OR bowcolumn OR within the rows that make up the ship 
    	else {
    		// if not horizontal, check if it on the same vertical
    		// then check if the vertical ships facing south have anything ABOVE 
    		// if the row boundary is outside the southernmost boundary 
    		// it is false 
    		if (column != bowColumn || row > bowRow || row <= bowRow  - (length - 1)) {
    			return false; 
    		}  
    		indexShotOnShip = bowRow - row;
    		 
    	} 
    	
    	hit[indexShotOnShip] = true; 
    	return true;
    	
    	}
    	
    
    
    /**
     * returns true if every part of the ship has been hit and false otherwise 
     * @return
     */
    boolean isSunk() {
    	 
    	// use getHit() getter to access the private boolean hit
    	boolean [] hitShip = getHit();
    	// create a boolean to check if every single coordinate in the ship is hit 
    	// iterate through each coordinate of the ship to see if it is hit 
    	// use the private boolean earlier hit to iterate to see if every part is hit 
    	for ( int i = 0; i < hitShip.length; i++) {
    		// if ANY PART is not hit out of every one it iterates through
    		if (!hitShip[i]) {
    			// return false 
    			return false;
    		}
    	}
    	// if every part is hit, return true 
    	return true;
    }
    
    /**
     * returns single character string to use in the ocean print method 
     */
    @Override 
    public String toString() {
    	// if sunk, return s for sunk
    	if (isSunk()) {
    		return "s";
    	}
    	// if not sunk, return x for ship still there but has been hit
    	if (!isSunk()) {
    		return "x";
    	}
    	System.out.println("Unexpected, ship not sunk or hit.");
    	return null;
    }

} 
